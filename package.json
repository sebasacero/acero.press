{
  "name": "acero-press-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "uvicorn --app-dir api v1:app --reload --port 8000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "e2e": "playwright test",
    "shot": "node e2e/shot.mjs",
    "test:sql": "bash supabase/tests/micra_atomic_sale/run.sh",
    "micra:build": "vite build --config vite.micra.config.js && cap sync",
    "micra:ios": "npm run micra:build && cap run ios",
    "micra:android": "npm run micra:build && cap run android",
    "micra:xcode": "npm run micra:build && cap open ios",
    "micra:studio": "npm run micra:build && cap open android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@supabase/supabase-js": "^2.45.4",
    "maplibre-gl": "6.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
