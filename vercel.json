{
  "crons": [
    {
      "path": "/api/v1/collect",
      "schedule": "0 17 * * *"
    }
  ],
  "functions": {
    "api/v1.py": {
      "maxDuration": 20,
      "excludeFiles": "{node_modules,public,src,dist,image,CSS,JS,supabase,reports,research_notes}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/v1?__path=$1"
    },
    {
      "source": "/escuela",
      "destination": "/escuela.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/micra-app/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/mapa/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Range"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "Content-Range, Content-Length, ETag"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
