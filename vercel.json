{
  "functions": {
    "api/v1.py": {
      "maxDuration": 20,
      "excludeFiles": "{node_modules,public,src,dist,image,CSS,JS,supabase,reports,research_notes}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/v1?__path=$1"
    },
    {
      "source": "/escuela",
      "destination": "/escuela.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/micra-app/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
