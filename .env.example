VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Solo para /api/create-checkout-session.js (función serverless) ---
# Estas NUNCA deben tener el prefijo VITE_ (eso las metería en el bundle del
# navegador, visibles para cualquiera). Se configuran en tu proveedor de
# hosting (Vercel/Netlify → variables de entorno del proyecto), no en el
# frontend.

# Developers → API keys → "Secret key" en el dashboard de Stripe.
# sk_test_... mientras pruebas, sk_live_... para cobrar de verdad.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Developers → Webhooks → tu endpoint → "Signing secret" en el dashboard de Stripe.
# Necesaria para /api/stripe-webhook.js (confirma el pago automáticamente).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Pagos locales de Colombia (Wompi) ---
# Dashboard de Wompi → Configuración → API Keys.
# La pública SÍ lleva el prefijo VITE_ porque la usa el navegador para
# tokenizar tarjetas directamente contra Wompi (nunca toca tu servidor).
VITE_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_WOMPI_ENV=sandbox

# Estas dos NUNCA en el frontend — solo las usan las funciones serverless.
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard de Wompi → Configuración → Eventos → "Secreto" (para /api/wompi-webhook.js).
WOMPI_EVENTS_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_ENV=sandbox

# Project Settings → API → "service_role secret" en el dashboard de Supabase.
# Tiene permisos totales sobre la base de datos — trátala como una contraseña.
SUPABASE_SERVICE_ROLE_KEY=

# La misma URL del proyecto que usas arriba (sin el prefijo VITE_, porque
# este valor lo lee el servidor, no el navegador).
SUPABASE_URL=

# --- Agente de IA del dashboard (análisis de mercado con Claude) ---
# console.anthropic.com → Settings → API Keys. Esto NO es lo mismo que un
# plan de Claude.ai/Claude Max — esa es una suscripción para chatear en la
# app, no algo que un servidor pueda usar para llamar al modelo. Se necesita
# esta API key (factura por uso) para que /api/growth-agent.js funcione.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
